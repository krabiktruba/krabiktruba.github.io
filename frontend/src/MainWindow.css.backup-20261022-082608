:root {
  --cm-bg: #090b13;
  --cm-panel: #0e111c;
  --cm-panel-2: #121624;
  --cm-border: #222638;
  --cm-text: #eff0fa;
  --cm-muted: #858ba3;
  --cm-purple: #8b5cf6;
  --cm-purple-hover: #a078ff;
}

.comind-layout, .comind-layout * { box-sizing: border-box; }
.comind-layout {
  display: flex; width: 100%; height: 100vh; height: 100dvh;
  overflow: hidden; color: var(--cm-text); background: var(--cm-bg);
  font-family: Inter, "Segoe UI", Arial, sans-serif; font-size: 14px;
}
.comind-layout button { color: inherit; font: inherit; cursor: pointer; }
.comind-layout button:focus-visible, .comind-layout input:focus-visible {
  outline: 2px solid var(--cm-purple); outline-offset: 2px;
}
.comind-rail {
  width: 70px; flex-shrink: 0; display: flex; align-items: center;
  gap: 12px; padding: 16px 0; flex-direction: column;
  background: #090a11; border-right: 1px solid var(--cm-border);
}
.comind-brand, .comind-community-icon, .comind-add-community, .comind-avatar {
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  border: 1px solid transparent; border-radius: 17px;
  background: #191d2b; transition: border-radius .15s, background .15s;
}
.comind-brand { width: 43px; height: 43px; font-size: 23px !important; font-weight: 900 !important; background: var(--cm-purple); }
.comind-community-icon { width: 43px; height: 43px; font-size: 12px !important; font-weight: 800 !important; }
.comind-community-icon:hover, .comind-brand:hover { border-radius: 12px; }
.comind-community-icon.active { background: #38255f; border-color: #8b5cf6; border-radius: 12px; }
.comind-rail-divider { width: 30px; height: 1px; background: #303449; }
.comind-add-community { width: 43px; height: 43px; color: #a78bfa !important; font-size: 25px !important; background: #17162a; }
.comind-add-community:hover { background: #2a2044; }
.comind-rail-spacer { flex: 1; }
.comind-avatar { width: 38px; height: 38px; border-radius: 50%; background: #30234e; color: #d9c8ff !important; font-weight: 800 !important; }
.comind-avatar.small { width: 27px; height: 27px; font-size: 12px !important; }
.comind-sidebar {
  width: 250px; flex-shrink: 0; display: flex; flex-direction: column;
  padding: 22px 14px 12px; background: var(--cm-panel);
  border-right: 1px solid var(--cm-border); min-height: 0;
}
.comind-sidebar-top { display: flex; align-items: center; justify-content: space-between; padding: 0 5px 22px; }
.comind-sidebar-top h2 { font-size: 22px; letter-spacing: 1px; margin: 5px 0 0; }
.comind-dot { color: var(--cm-purple); }
.comind-eyebrow { color: #9a83dc; font-size: 9px; font-weight: 800; letter-spacing: 1.6px; }
.comind-icon-button, .comind-chat-actions button {
  width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
  border: 1px solid var(--cm-border) !important; border-radius: 9px;
  background: #171a29; color: #b9a0ff !important;
}
.comind-icon-button:hover, .comind-chat-actions button:hover { background: #29213f; }
.comind-search {
  display: flex; align-items: center; gap: 9px; padding: 0 10px; height: 39px;
  border: 1px solid var(--cm-border); border-radius: 9px; background: #090c15; color: var(--cm-muted);
}
.comind-search input { min-width: 0; width: 100%; border: 0; outline: none; background: transparent; color: var(--cm-text); font-size: 12px; }
.comind-search input:focus-visible { outline: none; }
.comind-search button { border: 0; background: transparent; font-size: 18px; color: var(--cm-muted); }
.comind-nav-label { margin: 25px 7px 9px; color: #727991; font-size: 9px; font-weight: 800; letter-spacing: 1.1px; }
.comind-nav-item {
  display: flex; align-items: center; gap: 12px; width: 100%; padding: 10px 11px;
  margin: 2px 0; border: 1px solid transparent !important; border-radius: 8px;
  text-align: left; color: #9ca2b8 !important; background: transparent;
}
.comind-nav-item > span { width: 18px; text-align: center; font-size: 17px; }
.comind-nav-item:hover { background: #171a28; color: white !important; }
.comind-nav-item.selected { color: #e0d5ff !important; background: #211b37; border-color: #33254f !important; }
.comind-community-heading { display: flex; align-items: center; justify-content: space-between; }
.comind-community-heading button, .comind-channel-heading button {
  border: 0; background: transparent; color: #969bb0; font-size: 18px;
}
.comind-community-list { display: flex; flex-direction: column; gap: 3px; overflow-y: auto; }
.comind-community-row {
  display: flex; align-items: center; gap: 9px; width: 100%; padding: 8px;
  border: 1px solid transparent !important; border-radius: 8px; background: transparent;
  color: #b5b9cb !important; text-align: left;
}
.comind-community-row:hover { background: #191c2a; }
.comind-community-row.selected { background: #211b37; border-color: #33254f !important; color: white !important; }
.comind-community-mini { display: flex; align-items: center; justify-content: center; width: 27px; height: 27px; border-radius: 8px; background: #30244d; color: #d4c2ff; font-weight: 800; }
.comind-community-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.comind-member-count { color: #727991; font-size: 10px; }
.comind-empty-small { padding: 8px; color: var(--cm-muted); font-size: 12px; }
.comind-account { display: flex; align-items: center; gap: 9px; padding: 12px 2px 2px; margin-top: auto; border-top: 1px solid var(--cm-border); }
.comind-account-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.comind-account-info strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.comind-account-info span { color: var(--cm-muted); font-size: 10px; }
.comind-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.comind-topbar { height: 61px; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 0 24px; border-bottom: 1px solid var(--cm-border); background: #0b0d16; }
.comind-breadcrumb { display: flex; align-items: center; gap: 11px; min-width: 0; color: #858ba3; font-size: 12px; }
.comind-breadcrumb strong { color: #ececf8; font-weight: 600; }
.comind-breadcrumb-sep { color: #484e65; }
.comind-topbar-actions { display: flex; align-items: center; gap: 20px; }
.comind-status { display: flex; align-items: center; gap: 7px; white-space: nowrap; color: #969bb0; font-size: 11px; }
.comind-status i { width: 7px; height: 7px; border-radius: 50%; background: #e8b45f; }
.comind-profile-button { display: flex; align-items: center; gap: 8px; padding: 4px 0; border: 0; background: transparent; font-size: 12px !important; }
.comind-profile-button > span:last-child { color: #81869a; }
.comind-notice { margin: 12px 20px 0; padding: 10px 13px; border: 1px solid #49366d; border-radius: 8px; background: #1b1730; color: #d5c4ff; font-size: 12px; }
.comind-workspace { display: flex; flex: 1; min-height: 0; }
.comind-channel-sidebar { width: 220px; flex-shrink: 0; padding: 18px 10px; border-right: 1px solid var(--cm-border); background: #0d1019; overflow-y: auto; }
.comind-community-banner { padding: 0 7px 19px; border-bottom: 1px solid var(--cm-border); margin-bottom: 16px; }
.comind-community-cover { height: 78px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: radial-gradient(circle at 75% 25%, #5c3c95, #1a1c36 70%); color: #e1d5ff; font-size: 28px; font-weight: 900; }
.comind-community-banner h3 { margin: 13px 0 5px; font-size: 14px; }
.comind-community-banner p { margin: 0; color: var(--cm-muted); font-size: 11px; line-height: 1.5; }
.comind-channel-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 5px; margin: 17px 0 8px; color: #8288a0; font-size: 9px; font-weight: 800; letter-spacing: .7px; }
.comind-channel-heading button { font-size: 18px; }
.comind-channel { display: flex; align-items: center; gap: 9px; width: 100%; padding: 9px 10px; margin: 2px 0; border: 1px solid transparent !important; border-radius: 7px; background: transparent; color: #969cb2 !important; text-align: left; font-size: 12px !important; overflow: hidden; }
.comind-channel > span { color: #71778e; font-size: 16px; }
.comind-channel:hover { background: #171a27; color: #e2e3ef !important; }
.comind-channel.active { color: #e3d8ff !important; background: #211b37; border-color: #34264f !important; }
.comind-channel.active > span { color: #b99aff; }
.comind-voice-heading { margin-top: 25px; }
.comind-create-channel { width: 100%; margin-top: 17px; padding: 10px; border: 1px dashed #35384d !important; border-radius: 8px; background: transparent; color: #a3a7bb !important; font-size: 11px !important; text-align: left; }
.comind-create-channel:hover { border-color: var(--cm-purple) !important; color: #d4c3ff !important; }
.comind-chat { flex: 1; min-width: 0; display: flex; flex-direction: column; background: #0b0d15; }
.comind-chat-header { height: 66px; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: 0 22px; border-bottom: 1px solid var(--cm-border); }
.comind-chat-title { display: flex; align-items: center; gap: 11px; min-width: 0; }
.comind-hash { color: #a98af7; font-size: 23px; }
.comind-chat-title h3 { margin: 0; font-size: 13px; }
.comind-chat-title p { margin: 4px 0 0; color: var(--cm-muted); font-size: 10px; }
.comind-chat-actions { display: flex; gap: 7px; }
.comind-message-list { flex: 1; min-height: 0; overflow-y: auto; padding: 22px 25px; }
.comind-chat-welcome { padding: 22px 0 24px; margin-bottom: 18px; border-bottom: 1px solid #1e2232; }
.comind-welcome-icon { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 12px; background: #29203f; color: #c9b4ff; font-size: 25px; }
.comind-chat-welcome h2 { margin: 16px 0 7px; font-size: 20px; letter-spacing: -.5px; }
.comind-chat-welcome p { max-width: 470px; margin: 0; color: #9399af; font-size: 12px; line-height: 1.7; }
.comind-message { display: flex; gap: 12px; padding: 12px 0; }
.comind-message-avatar { display: flex; align-items: center; justify-content: center; width: 33px; height: 33px; flex-shrink: 0; border-radius: 50%; background: #30234e; color: #d5c3ff; font-weight: 800; }
.comind-message-content { min-width: 0; flex: 1; }
.comind-message-meta { display: flex; align-items: center; gap: 9px; }
.comind-message-meta strong { font-size: 12px; }
.comind-message-meta time { color: #747b92; font-size: 10px; }
.comind-message-content p { margin: 6px 0 0; color: #c3c6d5; font-size: 12px; line-height: 1.65; overflow-wrap: anywhere; white-space: pre-wrap; }
.comind-message-form { display: flex; align-items: center; gap: 10px; margin: 0 20px; padding: 8px 11px; border: 1px solid #2a2e42; border-radius: 11px; background: #131622; }
.comind-message-form > button:first-child { border: 0; background: transparent; color: #aaa0c6; font-size: 22px; }
.comind-message-form input { flex: 1; min-width: 0; padding: 7px 0; border: 0; outline: none; background: transparent; color: #f0effa; font-size: 12px; }
.comind-message-form input:focus-visible { outline: none; }
.comind-send-button { width: 31px; height: 31px; border: 0; border-radius: 8px; background: var(--cm-purple); color: white; }
.comind-send-button:hover:not(:disabled) { background: var(--cm-purple-hover); }
.comind-send-button:disabled { opacity: .4; cursor: default !important; }
.comind-local-hint { margin: 9px 22px 12px; color: #686f86; font-size: 9px; text-align: center; }
.comind-feature-page, .comind-page { flex: 1; overflow-y: auto; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 40px clamp(22px, 7vw, 90px); }
.comind-feature-page { align-items: center; text-align: center; }
.comind-feature-icon, .comind-page-icon { display: flex; align-items: center; justify-content: center; width: 58px; height: 58px; margin-bottom: 22px; border: 1px solid #45316a; border-radius: 17px; background: #211a37; color: #c9b4ff; font-size: 27px; }
.comind-feature-page h1, .comind-page h1 { margin: 0 0 12px; font-size: clamp(25px, 3vw, 38px); letter-spacing: -1px; }
.comind-feature-page p, .comind-page > p { max-width: 500px; color: #9ba0b4; font-size: 13px; line-height: 1.8; }
.comind-primary-button, .comind-secondary-button, .comind-danger-button { margin-top: 16px; padding: 10px 15px; border: 1px solid #4a3670 !important; border-radius: 8px; background: #281d43; color: #e2d7ff !important; }
.comind-primary-button:hover, .comind-secondary-button:hover { background: #392658; }
.comind-settings-card, .comind-profile-card { display: flex; flex-direction: column; gap: 15px; width: min(100%, 500px); margin-top: 20px; padding: 22px; border: 1px solid var(--cm-border); border-radius: 13px; background: var(--cm-panel); }
.comind-settings-card > div { display: flex; flex-direction: column; gap: 5px; padding-bottom: 13px; border-bottom: 1px solid var(--cm-border); }
.comind-settings-card strong { font-size: 12px; }
.comind-settings-card span, .comind-profile-card p { color: var(--cm-muted); font-size: 12px; }
.comind-profile-card { align-items: center; text-align: center; }
.comind-avatar.large { width: 64px; height: 64px; font-size: 24px !important; }
.comind-profile-card h2 { margin: 0; }
.comind-profile-card p { margin: 0; }
.comind-danger-button { border-color: #66313e !important; background: #351b25; color: #ffb4c0 !important; }
@media (max-width: 900px) {
  .comind-sidebar { width: 205px; }
  .comind-channel-sidebar { width: 185px; }
  .comind-topbar { padding: 0 14px; }
  .comind-status { display: none; }
}
@media (max-width: 650px) {
  .comind-rail { width: 52px; gap: 9px; }
  .comind-brand, .comind-community-icon, .comind-add-community { width: 35px; height: 35px; border-radius: 12px; }
  .comind-sidebar { width: 175px; padding: 14px 8px 9px; }
  .comind-sidebar-top h2 { font-size: 18px; }
  .comind-channel-sidebar { width: 145px; padding: 12px 7px; }
  .comind-topbar { height: 52px; }
  .comind-profile-button > span:not(.comind-avatar) { display: none; }
  .comind-message-list { padding: 12px; }
  .comind-message-form { margin: 0 10px; }
}
@media (max-width: 470px) {
  .comind-sidebar { display: none; }
  .comind-channel-sidebar { width: 125px; }
  .comind-chat-header { padding: 0 10px; }
  .comind-chat-title p { display: none; }
  .comind-chat-welcome h2 { font-size: 16px; }
}
