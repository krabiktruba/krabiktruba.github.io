:root {
  font-family: "Inter", sans-serif;
  color: #f5f5fc;
  background: #080910;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-optical-sizing: auto;
  font-weight: 400;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button, input { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: wait; opacity: 0.65; }

.app-shell {
  position: relative;
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 32px 20px;
  background: radial-gradient(ellipse at 50% 0%, #282052 0%, transparent 48%), #080910;
}

.ambient {
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.18;
  pointer-events: none;
}

.ambient-one { top: 10%; left: 4%; background: #7549ff; }
.ambient-two { right: 4%; bottom: 5%; background: #4334ca; }

.auth-card, .dashboard-card, .loading-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 440px;
  border: 1px solid #ffffff12;
  border-radius: 24px;
  background: #11121bef;
  box-shadow: 0 24px 90px #0007;
}

.auth-card { padding: 34px; }

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 2px;
}

.brand-mark {
  display: grid;
  width: 39px;
  height: 39px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #a78bfa, #6844ed);
  box-shadow: 0 5px 24px #7954ff50;
  color: white;
  font-size: 23px;
  font-weight: 800;
}

.auth-heading { margin: 35px 0 23px; }

.eyebrow {
  margin: 0 0 12px;
  color: #a695ff;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.7px;
}

h1 {
  margin: 0;
  font-size: clamp(26px, 5vw, 32px);
  font-weight: 700;
  letter-spacing: -1.2px;
}

.subtitle {
  margin: 11px 0 0;
  color: #9595aa;
  font-size: 13px;
  line-height: 1.7;
}

.mode-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
  margin-bottom: 23px;
  padding: 5px;
  border: 1px solid #ffffff08;
  border-radius: 12px;
  background: #090a12;
}

.mode-switch button {
  padding: 11px 8px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #9999ad;
  font-size: 12px;
  font-weight: 600;
}

.mode-switch button.mode-active {
  background: #29213f;
  color: #d5c9ff;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 9px;
  color: #d9d8e6;
  font-size: 12px;
  font-weight: 600;
}

.field input {
  width: 100%;
  min-width: 0;
  padding: 14px 15px;
  border: 1px solid #ffffff13;
  border-radius: 10px;
  outline: none;
  background: #0a0b13;
  color: #f5f5fc;
  font-size: 13px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.field input::placeholder { color: #606075; }

.field input:focus {
  border-color: #8c70f8;
  box-shadow: 0 0 0 3px #8c70f81b;
}

.password-wrapper {
  display: flex;
  align-items: center;
  gap: 7px;
  padding-right: 12px;
  border: 1px solid #ffffff13;
  border-radius: 10px;
  background: #0a0b13;
}

.password-wrapper:focus-within {
  border-color: #8c70f8;
  box-shadow: 0 0 0 3px #8c70f81b;
}

.password-wrapper input {
  border: 0;
  background: transparent;
  box-shadow: none;
}

.password-wrapper input:focus {
  border: 0;
  box-shadow: none;
}

.password-toggle {
  padding: 7px 0;
  border: 0;
  background: transparent;
  color: #a99aff;
  font-size: 10px;
  white-space: nowrap;
}

.form-extra {
  display: flex;
  justify-content: flex-end;
  margin-top: -8px;
  color: #7f7f94;
  font-size: 10px;
}

.primary-button {
  width: 100%;
  min-height: 48px;
  padding: 13px 16px;
  border: 0;
  border-radius: 10px;
  background: linear-gradient(105deg, #8055f5, #6741dc);
  box-shadow: 0 8px 24px #7148e52b;
  color: white;
  font-size: 13px;
  font-weight: 700;
  transition: filter 0.2s, transform 0.2s;
}

.primary-button:hover:not(:disabled) {
  filter: brightness(1.12);
  transform: translateY(-1px);
}

.message {
  padding: 12px;
  border-radius: 9px;
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.message-error {
  border: 1px solid #f8717133;
  background: #7f1d1d20;
  color: #ffaaaa;
}

.message-success {
  border: 1px solid #4ade8033;
  background: #16653420;
  color: #9ae6b4;
}

.auth-footer {
  margin: 24px 0 0;
  color: #88889c;
  font-size: 11px;
  text-align: center;
}

.text-button {
  padding: 0;
  border: 0;
  background: transparent;
  color: #b2a0ff;
  font-size: inherit;
  font-weight: 600;
}

.app-caption {
  position: absolute;
  bottom: 12px;
  color: #606075;
  font-size: 9px;
  letter-spacing: 1.5px;
  text-align: center;
}

.dashboard-card { padding: 30px; }
.dashboard-content { margin-top: 42px; }
.dashboard-content h1 { overflow-wrap: anywhere; }

.success-icon {
  display: grid;
  width: 46px;
  height: 46px;
  margin-bottom: 24px;
  place-items: center;
  border: 1px solid #4ade8035;
  border-radius: 15px;
  background: #16653425;
  color: #86efac;
  font-size: 25px;
}

.profile-info {
  display: grid;
  gap: 9px;
  margin: 26px 0 20px;
  padding: 18px;
  border: 1px solid #ffffff10;
  border-radius: 12px;
  background: #090a12;
}

.profile-info span { color: #88889c; font-size: 11px; }

.profile-info strong {
  margin-bottom: 9px;
  overflow-wrap: anywhere;
  font-size: 13px;
}

.profile-info strong:last-child { margin-bottom: 0; }

.status-line {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 22px;
  color: #9ae6b4;
  font-size: 11px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4ade80;
}

.loading-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 24px;
}

.loading-card p { color: #b4b3c5; font-size: 13px; }

@media (max-width: 480px) {
  .app-shell { padding: 20px 14px 36px; }

  .auth-card, .dashboard-card {
    padding: 25px 21px;
    border-radius: 19px;
  }

  .auth-heading { margin-top: 29px; }
}


