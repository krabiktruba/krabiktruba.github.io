              <aside className="members-panel">
                <div className="members-heading">СООБЩЕСТВО</div>
                <div className="community-cover"><div className="cover-orb orb-one" /><div className="cover-orb orb-two" /><span>{community.name.slice(0, 1).toUpperCase()}</span></div>
                <h3 className="member-community-name">{community.name}</h3>
                <p className="member-description">{community.description || "Место для общения, игр и совместных проектов."}</p>
                <div className="member-stat-row"><span>Участники</span><strong>{community.member_count ?? "—"}</strong></div>
                <div className="member-stat-row"><span>Каналы</span><strong>{channels.length}</strong></div>
                <div className="member-stat-row"><span>Соединение</span><strong className="green-text">API</strong></div>
                <button className="wide-primary" onClick={() => void joinCommunity(community)} disabled={loading}>Вступить в сообщество</button>
                <div className="next-features"><span>В РАЗРАБОТКЕ</span><p>Роли и права доступа</p><p>Голосовые комнаты</p><p>AI-помощник</p><p>Рейтинг и достижения</p></div>
              </aside>
            </div>
          </>
        ) : (
          <div className="discover-view">
            <header className="discover-top"><span className="connection-pill"><i /> COMIND PLATFORM</span><button className="secondary-button" onClick={() => void loadCommunities()}>↻ Обновить</button></header>
            <div className="discover-content">
              
              <h2>Играй вместе.<br /><span>Создавай сообщества.</span></h2>
              <p className="hero-description">Единое пространство для игровых сообществ, общения и совместных проектов.</p>
              <div className="discover-actions"><button className="primary-button" onClick={() => setShowCreateCommunity(true)}>＋ Создать сообщество</button><button className="secondary-button" onClick={() => document.getElementById("community-catalog")?.scrollIntoView({ behavior: "smooth" })}>Найти сообщество ↓</button></div>
              <div className="feature-grid">
                <div className="feature-card"><span className="feature-icon purple">⌘</span><h3>Свои сообщества</h3><p>Создавай пространства и собирай игроков.</p></div>
                <div className="feature-card"><span className="feature-icon blue">#</span><h3>Общение</h3><p>Текстовые каналы и сообщения, подключённые к backend.</p></div>
                <div className="feature-card"><span className="feature-icon pink">✧</span><h3>Развитие</h3><p>Роли, достижения, голос и AI — следующие модули.</p></div>
              </div>
              <div id="community-catalog" className="catalog-heading"><div><h3>Сообщества</h3></div><span>{filtered.length} найдено</span></div>
              <div className="discover-community-grid">
                {filtered.map((item) => <button key={item.id} className="discover-community-card" onClick={() => void chooseCommunity(item)}><div className="discover-card-icon">{item.name.slice(0, 1).toUpperCase()}</div><div><strong>{item.name}</strong><p>{item.description || "Игровое сообщество COMIND"}</p><small>{item.member_count ?? 0} участников</small></div><span className="card-arrow">↗</span></button>)}
                {!filtered.length && <div className="catalog-empty">Сообщества не найдены. Создай своё или обнови список.</div>}
              </div>
               <footer className="discover-donation">
                 <div className="discover-donation-copy">
                   <span>COMIND COMMUNITY</span>
                   <h3>Поддержать COMIND</h3>
                   <p>Помоги развитию проекта. Здесь появится персональная ссылка для доната.</p>
                 </div>
                 <a
                   href="https://ko-fi.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   className="donation-link"
                 >
                   Поддержать проект ↗
                 </a>
               </footer>
            </div>
          </div>
        )}
      </section>

      {/* PROFILE_AND_FRIENDS_MODALS_V1 */}
      {showProfileEditor && (
        <div className="modal-backdrop" onMouseDown={(e) => { if (e.target === e.currentTarget) setShowProfileEditor(false); }}>
          <form className="comind-modal account-profile-modal" onSubmit={saveProfile}>
            <button type="button" className="modal-close" onClick={() => setShowProfileEditor(false)}>×</button>
            <span className="eyebrow">АККАУНТ</span>
            <h2>Профиль</h2>
            <label>Отображаемое имя
              <input value={profileDraft.display_name} maxLength={60}
                onChange={(e) => setProfileDraft((p) => ({ ...p, display_name: e.target.value }))}
                placeholder={username} />
            </label>
            <label>О себе
              <textarea value={profileDraft.bio} rows={3} maxLength={500}
                onChange={(e) => setProfileDraft((p) => ({ ...p, bio: e.target.value }))}
                placeholder="Расскажи о себе" />
            </label>
            <label>Статус
              <select value={profileDraft.status}
                onChange={(e) => setProfileDraft((p) => ({ ...p, status: e.target.value as ProfileData["status"] }))}>
                <option value="online">В сети</option>
                <option value="away">Не активен</option>
                <option value="busy">Не беспокоить</option>
                <option value="offline">Не в сети</option>
              </select>
            </label>
            <label>URL аватара (HTTPS)
              <input value={profileDraft.avatar_url} maxLength={500000}
                onChange={(e) => setProfileDraft((p) => ({ ...p, avatar_url: e.target.value }))}
                placeholder="https://..." />
            </label>
            <button className="wide-primary" type="submit" disabled={profileSaving}>
              {profileSaving ? "Сохраняем..." : "Сохранить профиль"}
            </button>
          </form>
        </div>
      )}

      {showFriendsPanel && (
        <div className="modal-backdrop" onMouseDown={(event) => { if (event.target === event.currentTarget) setShowFriendsPanel(false); }}>
          <section className="comind-modal friends-modal">
            <button type="button" className="modal-close" onClick={() => setShowFriendsPanel(false)}>×</button>
            <span className="eyebrow">СОЦИАЛЬНАЯ СЕТЬ</span>
            <h2>Друзья</h2>
            <form className="friend-add-form" onSubmit={sendFriendRequest}>
              <label>Имя пользователя
                <input value={friendUsername} onChange={(event) => setFriendUsername(event.target.value)}
                  minLength={3} maxLength={32} pattern="[A-Za-z0-9_]+"
                  placeholder="Например, player_01" required />
              </label>
              <button type="submit" className="wide-primary">Отправить запрос</button>
            </form>
            {friendNotice && (
              <p className={`friend-notice ${friendNotice.error ? "is-error" : "is-success"}`} role="status">
                {friendNotice.text}
              </p>
            )}

            <div className="friends-modal-section">
              <h3>Входящие · {incomingFriends.length}</h3>
              {incomingFriends.map((item) => (
                <div className="friend-entry" key={item.request_id}>
                  <strong>{item.display_name || item.username}</strong>
                  <div>
                    <button type="button" onClick={() => void answerFriendRequest(item, "accept")}>Принять</button>
                    <button type="button" onClick={() => void answerFriendRequest(item, "reject")}>Отклонить</button>
                  </div>
                </div>
              ))}
              {!incomingFriends.length && <p className="empty-small">Нет входящих запросов.</p>}
            </div>


            <div className="friends-modal-section">
              <h3>{"\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430"} ? {incomingCommunityInvites.length}</h3>
              {incomingCommunityInvites.map((item) => (
                <div className="friend-entry" key={item.invitation_id}>
                  <div>
                    <strong>{item.community_name}</strong>
                    <small>
                      {"\u041e\u0442"} {item.inviter_display_name || item.inviter_username}
                      {" ? "}
                      {item.visibility === "private" ? "PRIVATE" : "PUBLIC"}
                    </small>
                  </div>
                  <div>
                    <button
                      type="button"
                      onClick={() => void answerCommunityInvitation(item, "accept")}
                    >
                      {"\u041f\u0440\u0438\u043d\u044f\u0442\u044c"}
                    </button>
                    <button
                      type="button"
                      onClick={() => void answerCommunityInvitation(item, "reject")}
                    >
                      {"\u041e\u0442\u043a\u043b\u043e\u043d\u0438\u0442\u044c"}
                    </button>
                  </div>
                </div>
              ))}
              {!incomingCommunityInvites.length && (
                <p className="empty-small">
                  {"\u041d\u0435\u0442 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0439."}
                </p>
              )}
            </div>

            <div className="friends-modal-section">
              <h3>Друзья · {friends.length}</h3>
              {friends.map((item) => (
                <div className="friend-entry" key={item.id}>
                  <div>
                    <strong>{item.display_name || item.username}</strong>
                    <small>{item.status || "offline"}</small>
                  </div>
                  {community && (
                    <button type="button" onClick={() => void sendCommunityInvitation(item)}>
                      {"\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c"}
                    </button>
                  )}
                  <button type="button" onClick={() => void removeFriend(item)}>Удалить</button>
                </div>
              ))}
              {!friends.length && <p className="empty-small">Пока нет друзей.</p>}
            </div>

            <div className="friends-modal-section">
              <h3>Отправленные · {outgoingFriends.length}</h3>
              {outgoingFriends.map((item) => (
                <div className="friend-entry" key={item.request_id}>
                  <strong>{item.display_name || item.username}</strong>
                  <button type="button" onClick={() => void cancelFriendRequest(item)}>Отозвать</button>
                </div>
              ))}
              {!outgoingFriends.length && <p className="empty-small">Нет ожидающих запросов.</p>}
            </div>

            <button type="button" className="secondary-button" disabled={friendsLoading}
              onClick={() => void loadFriends()}>
              {friendsLoading ? "Обновляем..." : "Обновить список"}
            </button>
          </section>
        </div>
      )}

      {showCreateCommunity && (
        <div className="modal-backdrop" onMouseDown={(e) => { if (e.target === e.currentTarget) setShowCreateCommunity(false); }}>
          <form className="comind-modal" onSubmit={createCommunity}>
            <button type="button" className="modal-close" onClick={() => setShowCreateCommunity(false)}>×</button>
            <span className="eyebrow">НОВОЕ ПРОСТРАНСТВО</span>
            <h2>Создать сообщество</h2>
            <p>Создай место для своей команды и сообщества.</p>
            <label>Название<input autoFocus value={communityName} onChange={(e) => setCommunityName(e.target.value)} maxLength={80} required placeholder="Например, Minecraft Squad" /></label>
            <label>Описание<textarea value={communityDescription} onChange={(e) => setCommunityDescription(e.target.value)} maxLength={500} placeholder="О чём ваше сообщество?" rows={3} /></label>

            <label>
              {"\u0422\u0438\u043f \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430"}
              <select
                value={communityVisibility}
                onChange={(event) => setCommunityVisibility(event.target.value as "public" | "private")}
              >
                <option value="public">{"\u041f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0435 \u2014 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u0432\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0435"}</option>
                <option value="private">{"\u041f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0435 \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044e"}</option>
              </select>
            </label>
            <button className="wide-primary" type="submit" disabled={loading}>{loading ? "Создаём..." : "Создать сообщество"}</button>
          </form>
        </div>
      )}

      {showCreateChannel && (
        <div className="modal-backdrop" onMouseDown={(e) => { if (e.target === e.currentTarget) setShowCreateChannel(false); }}>
          <form className="comind-modal" onSubmit={createChannel}>
            <button type="button" className="modal-close" onClick={() => setShowCreateChannel(false)}>×</button>
            <span className="eyebrow">НАСТРОЙКА СООБЩЕСТВА</span>
            <h2>Новый канал</h2>
            <p>Канал будет создан в «{community?.name}». По текущим правилам backend это может сделать владелец сообщества.</p>
            <label>Название канала<input autoFocus value={channelName} onChange={(e) => setChannelName(e.target.value)} maxLength={50} required placeholder="например, обсуждение" /></label>
            <label>Доступ
              <select value={channelVisibility} onChange={(e) => setChannelVisibility(e.target.value as "public" | "private")}>
                <option value="public">Открытый — участники сообщества</option>
                <option value="private">Закрытый — только приглашённые</option>
              </select>
            </label>
            <button className="wide-primary" type="submit" disabled={loading}>{loading ? "Создаём..." : "Создать канал"}</button>
          </form>
        </div>
      )}
          {showCreateVoiceChannel && (
        <div
          className="modal-backdrop"
          onMouseDown={(e) => {
            if (e.target === e.currentTarget) setShowCreateVoiceChannel(false);
          }}
        >
          <form className="comind-modal" onSubmit={createVoiceChannel}>
            <button
              type="button"
              className="modal-close"
              onClick={() => setShowCreateVoiceChannel(false)}
            >×</button>

            <span className="eyebrow">ГОЛОСОВЫЕ КАНАЛЫ</span>
            <h2>Новая голосовая комната</h2>
            <p>Комната будет создана в сообществе «{community?.name}».</p>

            <label>
              Название комнаты
              <input
                autoFocus
                value={voiceChannelName}
                onChange={(e) => setVoiceChannelName(e.target.value)}
                maxLength={50}
                required
                placeholder="Например, Общение"
              />

            </label>

            <label>
              {"\u0414\u043e\u0441\u0442\u0443\u043f \u043a \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435"}
              <select value={voiceChannelVisibility} onChange={(event) => setVoiceChannelVisibility(event.target.value as "public" | "private")}>
                <option value="public">{"\u041e\u0442\u043a\u0440\u044b\u0442\u0430\u044f \u2014 \u0432\u0441\u0435 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0438"}</option>
                <option value="private">{"\u041f\u0440\u0438\u0432\u0430\u0442\u043d\u0430\u044f \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0451\u043d\u043d\u044b\u0435"}</option>
              </select>
            </label>

            <button className="wide-primary" type="submit" disabled={loading}>
              {loading ? "Создаём..." : "Создать комнату"}
            </button>
          </form>
        </div>
      )}

      <button
        className="feature-launcher"
        onClick={() => setShowFeaturePanel(true)}
      >
        Все функции
      </button>

      {showFeaturePanel && (
        <FeaturePanel
          username={username}
          communityId={community?.id ?? null}
          channelId={channel?.id ?? null}
          onClose={() => setShowFeaturePanel(false)}
          onRefresh={() => {
            void loadProfile();
            void loadCommunities();
            if (community) void loadChannels(community);
          }}
          onCommunityDeleted={() => {
            setCommunity(null);
            setChannel(null);
            void loadCommunities();
          }}
        />
      )}

      <DirectMessages userId={userId} />
          {showBackgroundSettings && (
        <div className="background-settings-overlay" onClick={() => setShowBackgroundSettings(false)}>
          <section className="background-settings-modal" onClick={(event) => event.stopPropagation()}>
            <button type="button" className="background-settings-close" onClick={() => setShowBackgroundSettings(false)}>×</button>
            <div className="background-settings-eyebrow">COMIND SOON / PERSONALIZATION</div>
            <h2>Настройка внешнего вида</h2>
            <p>Создай собственную цветовую атмосферу приложения.</p>

            <label className="background-settings-color">
              <span>Основной оттенок</span>
              <input type="color" value={bgBase} onChange={(event) => setBgBase(event.target.value)} />
            </label>

            <label className="background-settings-color">
              <span>Дополнительный оттенок</span>
              <input type="color" value={bgAccent} onChange={(event) => setBgAccent(event.target.value)} />
            </label>

            <label className="background-settings-color">
              <span>Цвет свечения</span>
              <input type="color" value={bgGlow} onChange={(event) => setBgGlow(event.target.value)} />
            </label>

            <label className="background-settings-range">
              <span>Интенсивность: {bgIntensity}%</span>
              <input type="range" min="0" max="100" value={bgIntensity}
                onChange={(event) => setBgIntensity(Number(event.target.value))} />
            </label>

            <div className="background-settings-presets">
              <button type="button" onClick={() => {
                setBgBase("#080b18"); setBgAccent("#7855e8");
                setBgGlow("#258bcb"); setBgIntensity(55);
              }}>NEXUS</button>
              <button type="button" onClick={() => {
                setBgBase("#100817"); setBgAccent("#a13fba");
                setBgGlow("#ed639e"); setBgIntensity(65);
              }}>NEBULA</button>
              <button type="button" onClick={() => {
                setBgBase("#07131b"); setBgAccent("#087f91");
                setBgGlow("#3988df"); setBgIntensity(60);
              }}>ABYSS</button>
            </div>

            <button type="button" className="background-settings-done"
              onClick={() => setShowBackgroundSettings(false)}>Сохранить и закрыть</button>
          </section>
        </div>
      )}
</main>
  );
}


