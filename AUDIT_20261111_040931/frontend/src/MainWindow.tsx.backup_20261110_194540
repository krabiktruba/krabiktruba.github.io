import DirectMessages from "./DirectMessages";
import type { CSSProperties } from "react";
import { useCallback, useEffect, useState } from "react";
import "./MainWindow.css";
import VoiceRoom from "./VoiceRoom";
import FeaturePanel from "./FeaturePanel";
import { appPrompt, appConfirm } from "./appDialog";

const API = (import.meta.env.VITE_API_URL || "http://127.0.0.1:8000").replace(/\/+$/, "");

type AnyRecord = {
  id: number;
  [key: string]: any;
};

type Community = AnyRecord & {
  name: string;
  description?: string;
  member_count?: number;
  visibility?: "public" | "private";
  is_member?: boolean;
};

type Channel = AnyRecord & {
  name: string;
  channel_type?: string;
  visibility?: "public" | "private";
};

type Message = AnyRecord & {
  content: string;
  user_id?: number;
  username?: string;
  created_at?: string;
};

type ProfileData = {
  display_name: string;
  bio: string;
  avatar_url: string;
  status: "online" | "away" | "busy" | "offline";
};

type FriendItem = {
  id: number;
  username: string;
  display_name?: string;
  avatar_url?: string;
  status?: string;
  request_id?: number;
};

type FriendsResponse = {
  friends: FriendItem[];
  incoming: FriendItem[];
  outgoing: FriendItem[];
};

type CommunityInvitation = {
  invitation_id: number;
  community_id: number;
  community_name: string;
  visibility: "public" | "private";
  inviter_id: number;
  inviter_username: string;
  inviter_display_name?: string;
  inviter_avatar_url?: string;
};

async function apiRequest<T>(path: string, options: RequestInit = {}): Promise<T> {
  const headers = new Headers(options.headers);
  headers.set("Accept", "application/json");

  if (options.body) headers.set("Content-Type", "application/json");

  const token = localStorage.getItem("comind_access_token");
  if (token) headers.set("Authorization", `Bearer ${token}`);

  let response: Response;
  try {
    response = await fetch(`${API}${path}`, { ...options, headers });
  } catch {
    throw new Error("Backend недоступен. Запусти сервер COMIND на порту 8000.");
  }

  const data = response.status === 204 ? null : await response.json().catch(() => ({}));

  if (!response.ok) {
    const detail = (data as any)?.detail;
    const message = Array.isArray(detail)
      ? detail.map((x: any) => x.msg || "").join("; ")
      : detail;
    throw new Error(message || `Ошибка HTTP ${response.status}`);
  }

  return data as T;
}

function asArray<T>(value: any): T[] {
  if (Array.isArray(value)) return value;
  if (Array.isArray(value?.items)) return value.items;
  if (Array.isArray(value?.results)) return value.results;
  return [];
}

export default function MainWindow({
  username,
  userId,
  userIsAdmin = false,
  onLogout,
}: {
  username: string;
  userId?: number;
  userIsAdmin?: boolean;
  onLogout: () => void;
}) {
  const [communities, setCommunities] = useState<Community[]>([]);
  const [community, setCommunity] = useState<Community | null>(null);
  const [channels, setChannels] = useState<Channel[]>([]);
  const [channel, setChannel] = useState<Channel | null>(null);
  const [voiceChannel, setVoiceChannel] = useState<Channel | null>(null);
  const [messages, setMessages] = useState<Message[]>([]);
  const [messageText, setMessageText] = useState("");
  const [search, setSearch] = useState("");
  const [communityName, setCommunityName] = useState("");
  const [communityDescription, setCommunityDescription] = useState("");
  const [communityVisibility, setCommunityVisibility] = useState<"public" | "private">("public");
  const [channelName, setChannelName] = useState("");
  const [profile, setProfile] = useState<ProfileData>({
    display_name: "", bio: "", avatar_url: "", status: "online",
  });
  const [profileDraft, setProfileDraft] = useState<ProfileData>({
    display_name: "", bio: "", avatar_url: "", status: "online",
  });
  const [showProfileEditor, setShowProfileEditor] = useState(false);
  const [profileSaving, setProfileSaving] = useState(false);
  const [showFriendsPanel, setShowFriendsPanel] = useState(false);
  const [friends, setFriends] = useState<FriendItem[]>([]);
  const [incomingFriends, setIncomingFriends] = useState<FriendItem[]>([]);
  const [outgoingFriends, setOutgoingFriends] = useState<FriendItem[]>([]);
  const [incomingCommunityInvites, setIncomingCommunityInvites] = useState<CommunityInvitation[]>([]);
  const [friendUsername, setFriendUsername] = useState("");
  const [friendNotice, setFriendNotice] = useState<{ text: string; error: boolean } | null>(null);
  const [friendsLoading, setFriendsLoading] = useState(false);
  const [editingMessageId, setEditingMessageId] = useState<number | null>(null);
  const [editDraft, setEditDraft] = useState("");
  const [channelVisibility, setChannelVisibility] = useState<"public" | "private">("public");
  const [showCreateCommunity, setShowCreateCommunity] = useState(false);
  const [showCreateChannel, setShowCreateChannel] = useState(false);
  const [showCreateVoiceChannel, setShowCreateVoiceChannel] = useState(false);
  const [voiceChannelName, setVoiceChannelName] = useState("");
  const [voiceChannelVisibility, setVoiceChannelVisibility] = useState<"public" | "private">("public");
  const [loading, setLoading] = useState(false);
  const [notice, setNotice] = useState("");
  const [noticeError, setNoticeError] = useState(false);
  const [showBackgroundSettings, setShowBackgroundSettings] = useState(false);
  const [bgBase, setBgBase] = useState(() => localStorage.getItem("comind_bg_base") || "#080b18");
  const [bgAccent, setBgAccent] = useState(() => localStorage.getItem("comind_bg_accent") || "#7855e8");
  const [bgGlow, setBgGlow] = useState(() => localStorage.getItem("comind_bg_glow") || "#258bcb");
  const [bgIntensity, setBgIntensity] = useState(() => Number(localStorage.getItem("comind_bg_intensity") || 55));

  useEffect(() => {
    localStorage.setItem("comind_bg_base", bgBase);
    localStorage.setItem("comind_bg_accent", bgAccent);
    localStorage.setItem("comind_bg_glow", bgGlow);
    localStorage.setItem("comind_bg_intensity", String(bgIntensity));
  }, [bgBase, bgAccent, bgGlow, bgIntensity]);

  const backgroundStyle = {
    "--user-base": bgBase,
    "--user-accent": bgAccent,
    "--user-glow": bgGlow,
    "--user-intensity": `${bgIntensity}%`,
  } as CSSProperties;

  const notify = (text: string, isError = false) => {
    setNotice(text);
    setNoticeError(isError);
  };
  const loadProfile = useCallback(async (syncDraft = false) => {
    try {
      const data = await apiRequest<ProfileData>("/api/profile/me");
      const normalized: ProfileData = {
        display_name: data.display_name || "",
        bio: data.bio || "",
        avatar_url: data.avatar_url || "",
        status: data.status || "online",
      };
      setProfile(normalized);
      // Only initialize the editor draft on the first load/manual editor sync;
      // the 10-second poll must never overwrite edits currently in progress.
      if (syncDraft) setProfileDraft(normalized);
    } catch (error) {
      console.warn("Profile synchronization failed:", error);
    }
  }, []);



  const loadCommunities = useCallback(async () => {
    try {
      const result = await apiRequest<any>("/api/communities/");
      setCommunities(asArray<Community>(result));
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось загрузить сообщества", true);
    }
  }, []);

  const loadChannels = useCallback(async (selected: Community) => {
    setNotice("");
    try {
      const result = await apiRequest<any>(
        `/api/communities/${selected.id}/channels`,
      );
      const items = asArray<Channel>(result);

      // Меняем экран только после успешной проверки доступа.
      setCommunity(selected);
      setChannels(items);
      setChannel(items[0] ?? null);
      setMessages([]);

      if (!items.length) {
        notify("Ты вступил в сообщество, но в нём пока нет каналов.");
      }
      return true;
    } catch (error) {
      notify(
        error instanceof Error ? error.message : "Не удалось загрузить каналы",
        true,
      );
      return false;
    }
  }, []);

  const [showFeaturePanel, setShowFeaturePanel] = useState(false);
  useEffect(() => {
    void loadProfile(true);
    const timer = window.setInterval(() => void loadProfile(), 10000);
    return () => window.clearInterval(timer);
  }, [loadProfile]);

  useEffect(() => {
    if (!showFriendsPanel) return;
    const timer = window.setInterval(() => void loadFriends(), 10000);
    return () => window.clearInterval(timer);
  }, [showFriendsPanel]);

  useEffect(() => {
    void loadCommunities();
  }, [loadCommunities]);

  useEffect(() => {
    if (!channel || channel.channel_type === "voice") {
      setMessages([]);
      return;
    }

    let active = true;

    const loadMessages = async () => {
      try {
        const result = await apiRequest<any>(
          `/api/channels/${channel.id}/messages?limit=100`,
        );
        if (active) setMessages(asArray<Message>(result));
      } catch (error) {
        if (active) {
          setMessages([]);
          notify(error instanceof Error ? error.message : "Не удалось загрузить сообщения", true);
        }
      }
    };

    void loadMessages();
    const interval = window.setInterval(() => void loadMessages(), 5000);

    return () => {
      active = false;
      window.clearInterval(interval);
    };
  }, [channel]);

  // MESSAGE_STATUS_SYNC_V2
  useEffect(() => {
    if (!channel || channel.channel_type === "voice") return;
    let active = true;

    const refresh = async () => {
      try {
        const result = await apiRequest<any>(
          `/api/channels/${channel.id}/messages?limit=100`
        );
        if (active) setMessages(asArray<Message>(result));
      } catch {
        // Сохраняем последний успешно загруженный список.
      }
    };

    const timer = window.setInterval(() => void refresh(), 10000);
    return () => {
      active = false;
      window.clearInterval(timer);
    };
  }, [channel?.id]);

  async function chooseCommunity(item: Community) {
    if (loading) return;
    if (community?.id !== item.id) setVoiceChannel(null);
    setLoading(true);
    setNotice("");
    try {
      const opened = await loadChannels(item);
      if (opened) {
        await loadCommunities();
        notify(`Ты вошёл в «${item.name}».`);
      }
    } finally {
      setLoading(false);
    }
  }

  async function joinCommunity(item: Community) {
    if (loading) return;
    if (community?.id !== item.id) setVoiceChannel(null);

    setLoading(true);
    setNotice("");

    try {
      await apiRequest(`/api/communities/${item.id}/join`, {
        method: "POST",
      });

      const opened = await loadChannels(item);
      await loadCommunities();

      if (opened) {
        notify(`Ты вступил в «${item.name}».`);
      }
    } catch (error) {
      notify(
        error instanceof Error ? error.message : "Не удалось вступить",
        true,
      );
    } finally {
      setLoading(false);
    }
  }

  async function createCommunity(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!communityName.trim()) return;

    setLoading(true);
    try {
      const created = await apiRequest<Community>("/api/communities/", {
        method: "POST",
        body: JSON.stringify({
          name: communityName.trim(),
          description: communityDescription.trim(),
          visibility: communityVisibility,
        }),
      });

      setShowCreateCommunity(false);
      setCommunityName("");
      setCommunityDescription("");
      setCommunityVisibility("public");
      await loadCommunities();
      notify("Сообщество создано.");
      if (created?.id) await loadChannels(created);
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось создать сообщество", true);
    } finally {
      setLoading(false);
    }
  }

  async function createChannel(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!community || !channelName.trim()) return;

    setLoading(true);
    try {
      await apiRequest(`/api/communities/${community.id}/channels`, {
        method: "POST",
        body: JSON.stringify({ name: channelName.trim(), visibility: channelVisibility }),
      });
      setChannelName("");
      setChannelVisibility("public");
      setShowCreateChannel(false);
      const updated = await apiRequest<any>(
        `/api/communities/${community.id}/channels`,
      );
      const items = asArray<Channel>(updated);
      setChannels(items);
      if (items.length) setChannel(items[items.length - 1]);
      notify("Канал создан.");
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось создать канал", true);
    } finally {
      setLoading(false);
    }
  }

  async function createVoiceChannel(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();

    if (!community || !voiceChannelName.trim()) return;

    const name = voiceChannelName.trim();
    setLoading(true);

    try {
      await apiRequest(`/api/communities/${community.id}/voice-channels`, {
        method: "POST",
        body: JSON.stringify({ name, visibility: voiceChannelVisibility }),
      });

      const updated = await apiRequest<any>(
        `/api/communities/${community.id}/channels`,
      );

      const items = asArray<Channel>(updated);
      setChannels(items);

      const created = items.find(
        (item) => item.channel_type === "voice" && item.name === name
      );

      setVoiceChannelName("");
      setVoiceChannelVisibility("public");
      setShowCreateVoiceChannel(false);

      if (created) {
        selectChannel(created);
      }

      notify("Голосовая комната создана.");
    } catch (error) {
      notify(
        error instanceof Error ? error.message : "Не удалось создать голосовую комнату",
        true
      );
    } finally {
      setLoading(false);
    }
  }

  async function sendMessage(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!channel || !messageText.trim()) return;

    const content = messageText.trim();
    setMessageText("");

    try {
      const sent = await apiRequest<Message>(
        `/api/channels/${channel.id}/messages`,
        {
          method: "POST",
          body: JSON.stringify({ content }),
        },
      );
      setMessages((previous) => [...previous, sent]);
    } catch (error) {
      setMessageText(content);
      notify(error instanceof Error ? error.message : "Сообщение не отправлено", true);
    }
  }

  async function deleteMessage(item: Message) {
    if (!(await appConfirm({ title: "\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435?", message: "\u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c.", confirmText: "\u0423\u0434\u0430\u043b\u0438\u0442\u044c", danger: true }))) return;
    try {
      await apiRequest(`/api/messages/${item.id}`, { method: "DELETE" });
      setMessages((previous) => previous.filter((message) => message.id !== item.id));
      notify("Сообщение удалено.");
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось удалить сообщение", true);
    }
  }

  function editMessage(item: Message) {
    setEditingMessageId(Number(item.id));
    setEditDraft(item.content ?? "");
  }

  function cancelEditMessage() {
    setEditingMessageId(null);
    setEditDraft("");
  }

  async function saveEditedMessage(item: Message) {
    const messageId = Number(item.id);
    const content = editDraft.trim();

    if (!Number.isInteger(messageId) || messageId < 1) {
      notify("Не удалось определить ID сообщения.", true);
      return;
    }
    if (!content) {
      notify("Сообщение не может быть пустым.", true);
      return;
    }

    try {
      const updated = await apiRequest<Message>(`/api/messages/${messageId}`, {
        method: "PUT",
        body: JSON.stringify({ content }),
      });

      setMessages((previous) =>
        previous.map((message) =>
          Number(message.id) === messageId ? { ...message, ...updated } : message
        )
      );
      setEditingMessageId(null);
      setEditDraft("");
      notify("Сообщение обновлено.");
    } catch (error) {
      notify(
        error instanceof Error ? error.message : "Ошибка сохранения сообщения.",
        true
      );
    }
  }


  async function invitePrivateVoiceMember() {
    if (!voiceChannel || voiceChannel.visibility !== "private") return;

    const target = await appPrompt({
      title: "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0443\u044e \u043a\u043e\u043c\u043d\u0430\u0442\u0443",
      message: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 username \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430:",
      placeholder: "username",
      confirmText: "\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c",
    });
    if (!target?.trim()) return;

    try {
      await apiRequest(`/api/channels/${voiceChannel.id}/members`, {
        method: "POST",
        body: JSON.stringify({ username: target.trim() }),
      });
      notify("\u0423\u0447\u0430\u0441\u0442\u043d\u0438\u043a " + target.trim() + " \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d \u0432 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0443\u044e \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0443\u044e \u043a\u043e\u043c\u043d\u0430\u0442\u0443.");
    } catch (error) {
      notify(error instanceof Error ? error.message : "Invitation failed.", true);
    }
  }

  async function invitePrivateMember() {
    if (!channel || channel.visibility !== "private") return;

    const target = await appPrompt({ title: "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u044b\u0439 \u043a\u0430\u043d\u0430\u043b", message: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f:", placeholder: "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f", confirmText: "\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c" });
    if (!target || !target.trim()) return;

    try {
      await apiRequest(`/api/channels/${channel.id}/members`, {
        method: "POST",
        body: JSON.stringify({ username: target.trim() }),
      });
      notify(`Участник ${target.trim()} приглашён в закрытый канал.`);
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось пригласить участника", true);
    }
  }


  const filtered = communities.filter((item) =>
    `${item.name} ${item.description || ""}`.toLowerCase().includes(search.toLowerCase()),
  );


  async function saveProfile(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setProfileSaving(true);
    try {
      const updated = await apiRequest<ProfileData>("/api/profile/me", {
        method: "PATCH",
        body: JSON.stringify({
          display_name: profileDraft.display_name.trim(),
          bio: profileDraft.bio.trim(),
          avatar_url: profileDraft.avatar_url.trim(),
          status: profileDraft.status,
        }),
      });
      const normalized: ProfileData = {
        display_name: updated.display_name || "",
        bio: updated.bio || "",
        avatar_url: updated.avatar_url || "",
        status: updated.status || "online",
      };
      setProfile(normalized);
      setProfileDraft(normalized);
      setShowProfileEditor(false);
      notify("Профиль сохранён.");
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось сохранить профиль.", true);
    } finally {
      setProfileSaving(false);
    }
  }

  async function loadFriends() {
    setFriendsLoading(true);
    try {
      const [result, invitations] = await Promise.all([
        apiRequest<FriendsResponse>("/api/friends"),
        apiRequest<CommunityInvitation[]>("/api/community-invitations/incoming"),
      ]);

      setFriends(Array.isArray(result.friends) ? result.friends : []);
      setIncomingFriends(Array.isArray(result.incoming) ? result.incoming : []);
      setOutgoingFriends(Array.isArray(result.outgoing) ? result.outgoing : []);
      setIncomingCommunityInvites(
        Array.isArray(invitations) ? invitations : []
      );
    } catch (error) {
      const message = error instanceof Error ? error.message : "Не удалось загрузить друзей.";
      setFriendNotice({ text: message, error: true });
      notify(message, true);
    } finally {
      setFriendsLoading(false);
    }
  }

  async function sendFriendRequest(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const name = friendUsername.trim();
    if (!name) return;
    setFriendNotice(null);
    try {
      const result = await apiRequest<{status: string; username?: string}>("/api/friends/requests", {
        method: "POST",
        body: JSON.stringify({ username: name }),
      });
      setFriendUsername("");
      await loadFriends();
      const labels: Record<string, string> = {
        pending: "Запрос дружбы отправлен.",
        accepted: "Вы теперь друзья.",
        already_pending: "Запрос уже отправлен.",
        already_friends: "Этот пользователь уже в друзьях.",
      };
      const message = labels[result.status] || "Запрос обработан.";
      setFriendNotice({ text: message, error: false });
      notify(message);
    } catch (error) {
      const message = error instanceof Error ? error.message : "Не удалось отправить запрос.";
      setFriendNotice({ text: message, error: true });
      notify(message, true);
    }
  }

  async function answerFriendRequest(item: FriendItem, action: "accept" | "reject") {
    if (!item.request_id) return;
    try {
      await apiRequest(`/api/friends/requests/${item.request_id}`, {
        method: "PATCH",
        body: JSON.stringify({ action }),
      });
      await loadFriends();
      notify(action === "accept" ? "Запрос принят." : "Запрос отклонён.");
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось обработать запрос.", true);
    }
  }


  async function sendCommunityInvitation(item: FriendItem) {
    if (!community) {
      notify("\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e.", true);
      return;
    }

    try {
      const result = await apiRequest<{ status: string }>(
        `/api/communities/${community.id}/invitations`,
        {
          method: "POST",
          body: JSON.stringify({ invitee_id: item.id }),
        }
      );

      notify(
        result.status === "already_pending"
          ? "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0443\u0436\u0435 \u043e\u0436\u0438\u0434\u0430\u0435\u0442 \u043e\u0442\u0432\u0435\u0442\u0430."
          : "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e."
      );
    } catch (error) {
      notify(
        error instanceof Error ? error.message : "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435.",
        true
      );
    }
  }

  async function answerCommunityInvitation(
    item: CommunityInvitation,
    action: "accept" | "reject",
  ) {
    try {
      await apiRequest(
        `/api/community-invitations/${item.invitation_id}`,
        {
          method: "PATCH",
          body: JSON.stringify({ action }),
        }
      );

      await Promise.all([loadFriends(), loadCommunities()]);

      notify(
        action === "accept"
          ? "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u043d\u044f\u0442\u043e."
          : "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u043e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u043e."
      );
    } catch (error) {
      notify(
        error instanceof Error ? error.message : "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435.",
        true
      );
    }
  }

  async function cancelFriendRequest(item: FriendItem) {
    if (!item.request_id) {
      const message = "Не найден идентификатор исходящего запроса. Обнови список друзей.";
      setFriendNotice({ text: message, error: true });
      notify(message, true);
      return;
    }
    try {
      await apiRequest(`/api/friends/requests/${item.request_id}`, { method: "DELETE" });
      const message = "Запрос в друзья отменён.";
      setFriendNotice({ text: message, error: false });
      notify(message);
      await loadFriends();
    } catch (error) {
      const message = error instanceof Error ? error.message : "Не удалось отозвать запрос в друзья.";
      setFriendNotice({ text: message, error: true });
      notify(message, true);
    }
  }

  async function removeFriend(item: FriendItem) {
    if (!(await appConfirm({ title: "\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0438\u0437 \u0434\u0440\u0443\u0437\u0435\u0439", message: `\u0423\u0434\u0430\u043b\u0438\u0442\u044c ${item.username} \u0438\u0437 \u0434\u0440\u0443\u0437\u0435\u0439?`, confirmText: "\u0423\u0434\u0430\u043b\u0438\u0442\u044c", danger: true }))) return;
    try {
      await apiRequest(`/api/friends/${item.id}`, { method: "DELETE" });
      await loadFriends();
      notify("Пользователь удалён из друзей.");
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось удалить друга.", true);
    }
  }

  function selectChannel(item: Channel) {
    setChannel(item);
    if (item.channel_type === "voice") {
      // Keep the active VoiceRoom mounted while the user opens text channels.
      setVoiceChannel(item);
    }
  }

  async function renameChannel(item: Channel) {
    const entered = await appPrompt({ title: "\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c \u043a\u0430\u043d\u0430\u043b", message: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043d\u043e\u0432\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u043d\u0430\u043b\u0430:", defaultValue: item.name, placeholder: "\u041d\u043e\u0432\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435", confirmText: "\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c" });
    if (entered === null) return;
    const name = entered.trim();
    if (name.length < 2 || name.length > 50 || !/^[\p{L}\p{N}_ -]+$/u.test(name)) {
      notify("Название: 2–50 символов. Разрешены буквы любого языка, цифры, пробелы, _ и -.", true);
      return;
    }
    try {
      const updated = await apiRequest<{id: number; name: string}>(
        `/api/channels/${item.id}`,
        { method: "PATCH", body: JSON.stringify({ name }) }
      );
      const nextName = updated.name || name;
      setChannels((previous) => previous.map((entry) =>
        entry.id === item.id ? { ...entry, name: nextName } : entry
      ));
      setChannel((previous) =>
        previous && previous.id === item.id ? { ...previous, name: nextName } : previous
      );
      notify("Канал переименован.");
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось переименовать канал.", true);
    }
  }




  async function deleteCommunity(item: Community) {
    if (!(await appConfirm({ title: "\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e", message: `\u0421\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u00ab${item.name}\u00bb \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0430\u043b\u0435\u043d\u043e \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043a\u0430\u043d\u0430\u043b\u0430\u043c\u0438 \u0438 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c\u0438. \u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043e\u0431\u0440\u0430\u0442\u0438\u043c\u043e.`, confirmText: "\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e", danger: true }))) return;
    setLoading(true);
    try {
      await apiRequest(`/api/communities/${item.id}`, { method: "DELETE" });
      setVoiceChannel(null);
      setCommunity(null);
      setChannel(null);
      setChannels([]);
      setMessages([]);
      await loadCommunities();
      notify(`Сообщество «${item.name}» удалено.`);
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось удалить сообщество.", true);
    } finally {
      setLoading(false);
    }
  }

  async function leaveCommunity(item: Community) {
    const isOwner = userId !== undefined && Number(item.owner_id) === Number(userId);
    const question = isOwner
      ? `Ты владелец «${item.name}». При выходе владение будет передано другому участнику. Продолжить?`
      : `Покинуть сообщество «${item.name}»?`;
    if (!(await appConfirm({ title: "\u041f\u043e\u043a\u0438\u043d\u0443\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e", message: question, confirmText: "\u041f\u043e\u043a\u0438\u043d\u0443\u0442\u044c" }))) return;
    setLoading(true);
    try {
      await apiRequest(`/api/communities/${item.id}/leave`, { method: "DELETE" });
      setVoiceChannel(null);
      setCommunity(null);
      setChannel(null);
      setChannels([]);
      setMessages([]);
      await loadCommunities();
      notify(`Ты покинул сообщество «${item.name}».`);
    } catch (error) {
      notify(error instanceof Error ? error.message : "Не удалось покинуть сообщество.", true);
    } finally {
      setLoading(false);
    }
  }


