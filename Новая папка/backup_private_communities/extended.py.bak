        return {"status": "updated", "muted": data.muted}


# ---------------------- Friends API ----------------------

class FriendRequestCreate(BaseModel):
    username: str = Field(min_length=3, max_length=32, pattern=r"^[a-zA-Z0-9_]+$")


class FriendRequestAction(BaseModel):
    action: str = Field(pattern=r"^(accept|reject)$")


@router.get("/api/friends")
def get_friends(user=Depends(current_user)):
    with get_db() as db:
        uid = user["id"]

        friends = [dict(row) for row in db.execute("""
            SELECT u.id, u.username, u.display_name, u.avatar_url, u.status
            FROM friend_requests fr
            JOIN users u ON u.id = CASE
                WHEN fr.sender_id = ? THEN fr.receiver_id
                ELSE fr.sender_id
            END
            WHERE (fr.sender_id = ? OR fr.receiver_id = ?)
              AND fr.status = 'accepted'
            ORDER BY u.username COLLATE NOCASE
        """, (uid, uid, uid))]

        incoming = [dict(row) for row in db.execute("""
            SELECT fr.id AS request_id, u.id, u.username,
                   u.display_name, u.avatar_url, u.status
            FROM friend_requests fr
            JOIN users u ON u.id = fr.sender_id
            WHERE fr.receiver_id = ? AND fr.status = 'pending'
            ORDER BY fr.id DESC
        """, (uid,))]

        outgoing = [dict(row) for row in db.execute("""
            SELECT fr.id AS request_id, u.id, u.username,
                   u.display_name, u.avatar_url, u.status
            FROM friend_requests fr
            JOIN users u ON u.id = fr.receiver_id
            WHERE fr.sender_id = ? AND fr.status = 'pending'
            ORDER BY fr.id DESC
        """, (uid,))]

        return {"friends": friends, "incoming": incoming, "outgoing": outgoing}


@router.post("/api/friends/requests", status_code=201)
def create_friend_request(data: FriendRequestCreate, user=Depends(current_user)):
    with get_db() as db:
        target = db.execute(
            "SELECT id, username FROM users WHERE username = ? COLLATE NOCASE",
            (data.username.strip(),),
        ).fetchone()

        if target is None:
            raise HTTPException(404, "Пользователь не найден")
        if target["id"] == user["id"]:
            raise HTTPException(400, "Нельзя добавить самого себя")

        sender_id = user["id"]
        receiver_id = target["id"]

        accepted = db.execute("""
            SELECT id FROM friend_requests
            WHERE status = 'accepted'
              AND ((sender_id = ? AND receiver_id = ?)
                OR (sender_id = ? AND receiver_id = ?))
            LIMIT 1
        """, (sender_id, receiver_id, receiver_id, sender_id)).fetchone()

        if accepted:
            return {"status": "already_friends", "username": target["username"]}

        reverse = db.execute("""
            SELECT id, status FROM friend_requests
            WHERE sender_id = ? AND receiver_id = ?
        """, (receiver_id, sender_id)).fetchone()

        if reverse and reverse["status"] == "pending":
            db.execute("""
                UPDATE friend_requests
                SET status = 'accepted', updated_at = CURRENT_TIMESTAMP
                WHERE id = ?
            """, (reverse["id"],))
            return {"status": "accepted", "username": target["username"]}

        existing = db.execute("""
            SELECT id, status FROM friend_requests
            WHERE sender_id = ? AND receiver_id = ?
        """, (sender_id, receiver_id)).fetchone()

        if existing and existing["status"] == "pending":
            return {"status": "already_pending", "username": target["username"]}

        if existing:
            db.execute("""
                UPDATE friend_requests
                SET status = 'pending', updated_at = CURRENT_TIMESTAMP
                WHERE id = ?
            """, (existing["id"],))
        else:
            db.execute("""
                INSERT INTO friend_requests(sender_id, receiver_id, status)
                VALUES (?, ?, 'pending')
            """, (sender_id, receiver_id))

        return {"status": "pending", "username": target["username"]}


@router.patch("/api/friends/requests/{request_id}")
def respond_friend_request(
    request_id: int,
    data: FriendRequestAction,
    user=Depends(current_user),
):
    with get_db() as db:
        request = db.execute("""
            SELECT id, sender_id, receiver_id, status
            FROM friend_requests WHERE id = ?
        """, (request_id,)).fetchone()

        if request is None:
            raise HTTPException(404, "Запрос дружбы не найден")
        if request["receiver_id"] != user["id"]:
            raise HTTPException(403, "Можно отвечать только на входящие запросы")
        if request["status"] != "pending":
            raise HTTPException(409, "Запрос уже обработан")

        status = "accepted" if data.action == "accept" else "rejected"
        db.execute("""
            UPDATE friend_requests
            SET status = ?, updated_at = CURRENT_TIMESTAMP
            WHERE id = ?
        """, (status, request_id))

        return {"status": status, "request_id": request_id}


@router.delete("/api/friends/{friend_id}")
def remove_friend(friend_id: int, user=Depends(current_user)):
    with get_db() as db:
        cur = db.execute("""
            DELETE FROM friend_requests
            WHERE status = 'accepted'
              AND ((sender_id = ? AND receiver_id = ?)
                OR (sender_id = ? AND receiver_id = ?))
        """, (user["id"], friend_id, friend_id, user["id"]))

        if not cur.rowcount:
            raise HTTPException(404, "Друг не найден")

        return {"status": "removed", "friend_id": friend_id}


@router.delete("/api/friends/requests/{request_id}")
def cancel_friend_request(request_id: int, user=Depends(current_user)):
    with get_db() as db:
        row = db.execute("""
            SELECT id FROM friend_requests
            WHERE id=? AND sender_id=? AND status='pending'
        """, (request_id, user["id"])).fetchone()

        if row is None:
            raise HTTPException(404, "Исходящий запрос не найден или уже обработан")

        db.execute("DELETE FROM friend_requests WHERE id=?", (request_id,))
        return {"status": "cancelled", "request_id": request_id}


# ---------------------- COMMUNITY INVITATIONS ----------------------

class CommunityInvitationCreate(BaseModel):
    invitee_id: int = Field(gt=0)


class CommunityInvitationAction(BaseModel):
    action: str = Field(pattern="^(accept|reject)$")


@router.get("/api/community-invitations/incoming")
def get_incoming_community_invitations(user=Depends(current_user)):
    with get_db() as db:
        rows = db.execute("""
            SELECT
                i.id AS invitation_id,
                i.community_id,
                i.created_at,
                c.name AS community_name,
                c.visibility,
                u.id AS inviter_id,
                u.username AS inviter_username,
                u.display_name AS inviter_display_name,
                u.avatar_url AS inviter_avatar_url
            FROM community_invitations i
            JOIN communities c ON c.id=i.community_id
            JOIN users u ON u.id=i.inviter_id
            WHERE i.invitee_id=? AND i.status='pending'
            ORDER BY i.id DESC
        """, (user["id"],)).fetchall()

        return [dict(row) for row in rows]


@router.post("/api/communities/{community_id}/invitations", status_code=201)
def invite_friend_to_community(
    community_id: int,
    data: CommunityInvitationCreate,
    user=Depends(current_user),
):
    inviter_id = int(user["id"])
    invitee_id = int(data.invitee_id)

    if inviter_id == invitee_id:
        raise HTTPException(400, "\u041d\u0435\u043b\u044c\u0437\u044f \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c \u0441\u0430\u043c\u043e\u0433\u043e \u0441\u0435\u0431\u044f")

    with get_db() as db:
        community = db.execute(
            "SELECT id, name FROM communities WHERE id=?",
            (community_id,),
        ).fetchone()

        if community is None:
            raise HTTPException(404, "\u0421\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e")

        inviter_membership = db.execute(
            """
            SELECT 1 FROM community_members
            WHERE community_id=? AND user_id=?
            """,
            (community_id, inviter_id),
        ).fetchone()

        if not inviter_membership and not user.get("is_admin"):
            raise HTTPException(403, "\u0414\u043b\u044f \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u044f \u043d\u0443\u0436\u043d\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u0442\u044c \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435")

        friendship = db.execute("""
            SELECT id FROM friend_requests
            WHERE status='accepted'
              AND (
                (sender_id=? AND receiver_id=?)
                OR
                (sender_id=? AND receiver_id=?)
              )
            LIMIT 1
        """, (inviter_id, invitee_id, invitee_id, inviter_id)).fetchone()

        if friendship is None:
            raise HTTPException(403, "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0440\u0443\u0437\u0435\u0439")

        target = db.execute(
            "SELECT id FROM users WHERE id=?",
            (invitee_id,),
        ).fetchone()

        if target is None:
            raise HTTPException(404, "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d")

        membership = db.execute(
            """
            SELECT 1 FROM community_members
            WHERE community_id=? AND user_id=?
            """,
            (community_id, invitee_id),
        ).fetchone()

        if membership:
            raise HTTPException(409, "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0443\u0436\u0435 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435")

        existing = db.execute("""
            SELECT id FROM community_invitations
            WHERE community_id=? AND invitee_id=? AND status='pending'
        """, (community_id, invitee_id)).fetchone()

        if existing:
            return {
                "status": "already_pending",
                "invitation_id": existing["id"],
            }

        cursor = db.execute("""
            INSERT INTO community_invitations
                (community_id, inviter_id, invitee_id)
            VALUES (?, ?, ?)
        """, (community_id, inviter_id, invitee_id))

        invitation_id = cursor.lastrowid

        notify(
            db,
            invitee_id,
            "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e",
            f"\u0412\u0430\u0441 \u043f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u043b\u0438 \u0432 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u00ab{community['name']}\u00bb",
        )

        return {
            "status": "pending",
            "invitation_id": invitation_id,
            "community_id": community_id,
        }


@router.patch("/api/community-invitations/{invitation_id}")
def answer_community_invitation(
    invitation_id: int,
    data: CommunityInvitationAction,
    user=Depends(current_user),
):
    with get_db() as db:
        invitation = db.execute("""
            SELECT id, community_id, inviter_id, invitee_id, status
            FROM community_invitations
            WHERE id=?
        """, (invitation_id,)).fetchone()

        if invitation is None:
            raise HTTPException(404, "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e")

        if int(invitation["invitee_id"]) != int(user["id"]):
            raise HTTPException(403, "\u042d\u0442\u043e \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0430\u0434\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u043e \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044e")

        if invitation["status"] != "pending":
            raise HTTPException(409, "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0443\u0436\u0435 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043e")

        community = db.execute(
            "SELECT id, name FROM communities WHERE id=?",
            (invitation["community_id"],),
        ).fetchone()

        if community is None:
            raise HTTPException(404, "\u0421\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442")

        if data.action == "accept":
            db.execute("""
                INSERT OR IGNORE INTO community_members
                    (community_id, user_id, role)
                VALUES (?, ?, 'member')
            """, (invitation["community_id"], user["id"]))

            status = "accepted"

            notify(
                db,
                invitation["inviter_id"],
                "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u043d\u044f\u0442\u043e",
                f"\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u043f\u0440\u0438\u043d\u044f\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u00ab{community['name']}\u00bb",
            )
        else:
            status = "rejected"

            notify(
                db,
                invitation["inviter_id"],
                "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u043e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u043e",
                f"\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0432 \u00ab{community['name']}\u00bb",
            )

        updated = db.execute("""
            UPDATE community_invitations
            SET status=?, responded_at=CURRENT_TIMESTAMP
            WHERE id=? AND status='pending'
        """, (status, invitation_id))

        if updated.rowcount != 1:
            raise HTTPException(409, "\u041f\u0440\u0438\u0433\u043b\u0430\u0448\u0435\u043d\u0438\u0435 \u0443\u0436\u0435 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043e")

        return {
            "status": status,
            "invitation_id": invitation_id,
            "community_id": invitation["community_id"],
        }

